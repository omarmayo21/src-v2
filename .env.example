# -----------------------------------------------------------------------------
# SRFEC Stones & Granite - Environment Configuration Example
# Copy this file to .env.local for local development.
# In Vercel, add these under Settings -> Environment Variables.
# -----------------------------------------------------------------------------

# Canonical site URL (used for metadataBase, sitemap.xml, robots.txt, hreflang)
NEXT_PUBLIC_SITE_URL=https://www.srfec.com

# Optional contact form endpoint (defaults to front-end simulation / /api/contact)
# Examples: /api/contact | https://formspree.io/f/xxxxxx | https://api.resend.com/emails
NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact

# Optional database URL (if using drizzle-orm with Neon / Postgres)
# DATABASE_URL=postgresql://user:password@host:5432/srfec?sslmode=require

